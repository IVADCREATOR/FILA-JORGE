# Caminho do arquivo SQLite (nunca dentro de pasta servida publicamente)
DATABASE_PATH=./data/sorasaki.db

# Porta da API
PORT=3000

# Ambiente
NODE_ENV=development

# Autenticação
SESSION_COOKIE_NAME=sorasaki_session
SESSION_TTL_HOURS=720

# CORS: origens confiáveis separadas por vírgula (sem espaço), ex:
# CORS_TRUSTED_ORIGINS=https://sorasaki.com,https://admin.sorasaki.com
# Vazio = só requests same-origin funcionam.
CORS_TRUSTED_ORIGINS=

